# ============================================================================
# PLANTILLA DE VARIABLES PARA RAILWAY — Sweep Reversal Map Bot
# ============================================================================
# Cómo usarla:
#   1. Railway -> tu servicio -> pestaña "Variables" -> botón "Raw Editor"
#   2. Pega TODO este bloque de una vez
#   3. Rellena los valores vacíos (BINGX_*, TELEGRAM_*, WEBHOOK_SECRET)
#   4. Save -> Railway redeploya solo
#
# Las líneas que empiezan por # son comentarios, Railway las ignora.
# No subas este archivo relleno a GitHub (usa el .env.example del repo,
# que no lleva tus claves).
# ============================================================================

# ---------------------------------------------------------------------------
# BingX — API de trading
# ---------------------------------------------------------------------------
# Crea la key en BingX con permiso de FUTUROS/TRADING activado y
# RETIRO DESACTIVADO. Pégala sin espacios ni saltos de línea al final.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_RECV_WINDOW_MS=5000
# true = opera contra el saldo de práctica VST (dinero simulado).
# El propio cliente ya fuerza la URL correcta de VST cuando esto es true,
# aunque BINGX_BASE_URL de arriba apunte a producción.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Telegram — para las señales y avisos
# ---------------------------------------------------------------------------
# Token: habla con @BotFather -> /newbot
# Chat ID: habla con @userinfobot, o manda un mensaje a tu bot y consulta
#          https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Modo de operación
# ---------------------------------------------------------------------------
# false = SOLO manda señales a Telegram, no ejecuta nada. EMPIEZA AQUÍ.
# true  = ejecuta las órdenes en BingX de verdad.
LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Universo de símbolos
# ---------------------------------------------------------------------------
# ALL = todos los perpetuos USDT activos (filtrados por liquidez y
# meme-coins, ver abajo). O una lista explícita: BTC-USDT,ETH-USDT,SOL-USDT
SYMBOLS=ALL
TIMEFRAME=15m

# Solo aplican si SYMBOLS=ALL (una lista explícita los salta):
MIN_24H_VOLUME_USDT=20000000
MEME_BLOCKLIST_PATTERNS=BROCCOLI,BANANA,PEPE,DOGE,SHIB,FLOKI,WIF,BONK,MEME,INU,ELON,MOON,SAFE,BABY,CUM,PUMP,GASOLINE
SCAN_ALL_MAX_SYMBOLS=150

POLL_INTERVAL_SECONDS=60
SYMBOL_BATCH_SIZE=5
SYMBOL_BATCH_DELAY_SECONDS=1.0

# ---------------------------------------------------------------------------
# Parámetros de detección (idénticos a los inputs del script Pine)
# ---------------------------------------------------------------------------
SWING_LENGTH=5
SWEEP_ATR_LENGTH=14
MIN_PENETRATION_ATR=0.0
STRUCTURE_LENGTH=3
MAX_CONFIRMATION_BARS=12
MIN_DISPLACEMENT_ATR=0.2

# ---------------------------------------------------------------------------
# Riesgo
# ---------------------------------------------------------------------------
QTY_PCT=10.0
LEVERAGE=10
# Diseño propio -- el Pine original es solo visual, no trae SL/TP.
SWEEP_SL_ATR_BUFFER=0.3
SWEEP_RR_RATIO=2.0
# Evita abrir una entrada que pagaría funding desfavorable (0.005=0.5%).
FUNDING_RATE_MAX_ABS=0.005

# ---------------------------------------------------------------------------
# Salvaguardas propias del bot
# ---------------------------------------------------------------------------
MAX_CONCURRENT_POSITIONS=5
SKIP_IF_SYMBOL_HAS_POSITION=true
MIN_BALANCE_USDT=0
HARD_MAX_TOTAL_POSITIONS=5

# Secreto para /emergency-stop/<secret> del servidor de salud embebido.
# Genera uno con: openssl rand -hex 24
WEBHOOK_SECRET=

LOG_LEVEL=INFO
