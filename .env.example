# ── Modo ──────────────────────────────────────────────────────────
MODE=SIGNAL
LIVE_CONFIRMED=false

# ── BingX (solo hacen falta en LIVE) ──────────────────────────────
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Universo ──────────────────────────────────────────────────────
TIMEFRAME=15m
SCAN_INTERVAL_SEC=60
MAX_SYMBOLS=0
SYMBOL_WHITELIST=
EXCLUDE_PREFIXES=NC

# ── Estrategia (igual que el script Pine original) ─────────────────
RSI_LENGTH=10
RSI_SIGNAL_LENGTH=10
RSI_TRIGGER=50.0
RSI_TARGET_CROSSES=2
ST_ATR_PERIOD=10
ST_FACTOR=2.5

# ── Riesgo ────────────────────────────────────────────────────────
RISK_PCT=0.25
LEVERAGE=3
MAX_CONCURRENT=0
REENTRY_COOLDOWN_MIN=15
# Riesgo agregado máximo sumando TODAS las posiciones abiertas a la vez
# (aprox: nº posiciones × RISK_PCT). MAX_CONCURRENT limita cuántas,
# esto limita cuánto en conjunto.
MAX_TOTAL_RISK_PCT=3.0

# ── Circuit breaker ─────────────────────────────────────────────────
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_MINUTES=60

# ── Liquidez (el script Pine original no filtra por esto) ──────────
MIN_QUOTE_VOLUME_24H=2000000

# ── Stop de emergencia (solo LIVE, no está en el script Pine original) ─
# IMPORTANTE: con EMERGENCY_SL_ENABLED=true, este stop es también lo
# que define el tamaño de la posición — RISK_PCT es la pérdida real si
# salta, no una fracción de margen.
EMERGENCY_SL_ENABLED=true
EMERGENCY_SL_PCT=8.0

# ── Avisos ────────────────────────────────────────────────────────
DAILY_SUMMARY=true
DAILY_SUMMARY_HOUR_UTC=7
HEARTBEAT_HOURS=12

# ── Estado ────────────────────────────────────────────────────────
STATE_PATH=/data/state_rsi.json
LOG_LEVEL=INFO
