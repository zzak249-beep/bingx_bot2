# ── Credenciales BingX ────────────────────────────────────────────────
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_RECV_WINDOW_MS=5000
DEMO_MODE=False

# ── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LIVE_TRADING=True

# ── Universo de símbolos ─────────────────────────────────────────────
SYMBOLS=ALL
# El script original no fija timeframe. 15m es punto de partida
# razonable para estructura/reversión; cámbialo si prefieres otro.
TIMEFRAME=15m

# Solo aplican si SYMBOLS=ALL (una lista explícita los salta):
MIN_24H_VOLUME_USDT=20000000
MEME_BLOCKLIST_PATTERNS=BROCCOLI,BANANA,PEPE,DOGE,SHIB,FLOKI,WIF,BONK,MEME,INU,ELON,MOON,SAFE,BABY,CUM,PUMP,GASOLINE
SCAN_ALL_MAX_SYMBOLS=150

POLL_INTERVAL_SECONDS=60
SYMBOL_BATCH_SIZE=5
SYMBOL_BATCH_DELAY_SECONDS=1.0

# ── Parámetros de detección (idénticos a los inputs del script Pine) ──
SWING_LENGTH=5
SWEEP_ATR_LENGTH=14
MIN_PENETRATION_ATR=0.0
STRUCTURE_LENGTH=3
MAX_CONFIRMATION_BARS=12
MIN_DISPLACEMENT_ATR=0.2

# ── Riesgo ────────────────────────────────────────────────────────────
QTY_PCT=10.0
LEVERAGE=10
# Diseño propio -- el Pine original es solo visual, no trae SL/TP.
# SL = nivel barrido +/- este multiplo de ATR de colchón.
SWEEP_SL_ATR_BUFFER=0.3
# TP = entrada +/- (riesgo * este ratio)
SWEEP_RR_RATIO=2.0
# Evita abrir una entrada que pagaría funding desfavorable (0.005 = 0.5%
# por periodo). Se salta la comprobación si no se puede leer el dato.
FUNDING_RATE_MAX_ABS=0.005

# ── Salvaguardas propias del bot ───────────────────────────────────────
MAX_CONCURRENT_POSITIONS=5
SKIP_IF_SYMBOL_HAS_POSITION=True
MIN_BALANCE_USDT=0
HARD_MAX_TOTAL_POSITIONS=5

# Secreto para /emergency-stop/<secret> del servidor de salud embebido.
# Genera uno con: openssl rand -hex 24
WEBHOOK_SECRET=

LOG_LEVEL=INFO
