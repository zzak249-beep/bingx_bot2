# Copy this file to .env for local runs (`cp .env.example .env`) and fill
# in your own values. On Railway, set these under your service's
# Variables tab instead — Railway does not read .env files, it injects
# real environment variables.
#
# ────────────────────────────────────────────────────────────────────────
# SAFETY DEFAULTS: as shipped, this file has DRY_RUN=true and no API keys,
# so the bot will run in signal-only mode and cannot place a real order no
# matter what else is misconfigured. Change those two things deliberately,
# not by accident.
# ────────────────────────────────────────────────────────────────────────

# ── BingX ──────────────────────────────────────────────────────────────
# Create keys at bingx.com > API Management. You MUST tick "Perpetual
# Futures Trading" permission on the key, or live orders will fail with
# an authorization error even though the key works for reading data.
# Do NOT enable withdrawal permission on this key.
BINGX_API_KEY=
BINGX_API_SECRET=

MARKET_TYPE=swap

# SYMBOL_UNIVERSE: "all" = every active USDT-M perpetual swap on BingX
# (queried live at startup), OR a comma-separated list, e.g.
# "BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT". A single symbol is just a
# list of one. (The old SYMBOL variable still works as a fallback if
# SYMBOL_UNIVERSE isn't set, for anyone upgrading from the single-symbol
# version of this bot.)
SYMBOL_UNIVERSE=all
# Comma-separated symbols to always skip, even under "all".
SYMBOL_EXCLUDE=
# 0 = no filter = genuinely every active symbol. Set this (in USDT of 24h
# quote volume) to shrink the universe to more liquid pairs, which also
# shortens how long a full scan takes — see README for the cycle-time math.
MIN_24H_VOLUME_USDT=0
# Hard cap on simultaneously open positions ACROSS THE WHOLE PORTFOLIO.
# This is the single most important number in this file once
# SYMBOL_UNIVERSE=all — it's what keeps total exposure bounded when many
# symbols can fire at once instead of just one. See README for the math
# connecting this, QTY_PCT, and LEVERAGE to worst-case exposure.
MAX_CONCURRENT_POSITIONS=3

TIMEFRAME=5m
LEVERAGE=3

# The master safety switch. true = compute signals against real market
# data and log/notify what the bot WOULD have done, but never call
# create_order. Only set to false once you've watched it run correctly
# for a while and you accept the risk of real capital.
DRY_RUN=true

# ── Strategy (mirrors the Pine script inputs 1:1) ─────────────────────
LOOKBACK_ENERGY=40
K_DOMINANCE=1.5
COOLDOWN_BARS=4
USE_VOL_FILTER=false
VOL_LEN=20
VOL_MULT=1.2

# ── Risk management ────────────────────────────────────────────────────
QTY_PCT=10
USE_ATR_SL=true
ATR_LENGTH=14
ATR_MULT_SL=1.5
ATR_MULT_TP=2.5
SL_PERCENT=1.0
TP_PERCENT=2.0
USE_TRAIL=false
TRAIL_TRIGGER_ATR=1.0
TRAIL_OFFSET_ATR=1.0

# Circuit breaker: halts new entries for the rest of the UTC day once
# equity drawdown from that day's starting balance hits this percentage.
# Existing open positions keep their own SL/TP; this only blocks new ones.
MAX_DAILY_LOSS_PCT=5

# ── Sweep-reversal exit filter (optional, off by default) ─────────────
# Ported from a second script you shared ("Sweep Reversal Map [Herman]").
# Only the bearish half of that script was ever provided — the bullish
# half in bot/sweep_reversal.py is a reconstructed mirror, not verified
# against the original author's code. Used ONLY as an exit trigger on an
# already-open position; it never gates or blocks a new entry.
USE_SWEEP_EXIT_FILTER=false
SWEEP_SWING_LENGTH=5
SWEEP_ATR_LENGTH=14
SWEEP_MIN_PENETRATION=0.0
SWEEP_STRUCTURE_LENGTH=3
SWEEP_MAX_CONFIRMATION_BARS=12
SWEEP_MIN_DISPLACEMENT=0.2
# alert_only = Telegram alert, no action (default/safest)
# tighten_stop = move the stop to breakeven
# close_position = close the position immediately
SWEEP_EXIT_ACTION=alert_only

# ── Telegram ────────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram, send /newbot, copy the token below.
# 2. Send any message to your new bot, then open in a browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id": ...} value below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Loop ────────────────────────────────────────────────────────────────
POLL_SECONDS=30
LOG_LEVEL=INFO
